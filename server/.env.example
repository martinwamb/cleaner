# Port the API listens on (bound to 127.0.0.1; nginx proxies /api/ to it).
PORT=4003

# SQLite database file. Defaults to server/data.db when unset.
DB_FILE=/home/admin/apps/cleaner/server/data.db

# Signing key for operator session cookies.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Public origin, used in logs and future email links.
APP_URL=https://cleaner.wambugumartin.com
